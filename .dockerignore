# Build outputs — regenerated inside the image.
build/
.gradle/

# Local environment / secrets — never bake into images.
.env
.env.*
!.env.example

# IDE / editor noise.
.idea/
.vscode/
*.iml
.DS_Store

# VCS metadata is not needed at build time: the version reaches the image as the
# VERSION_TAG build argument (`dnc` passes the image tag), not from git.
.git/
.gitignore
.gitattributes

# Docs and Claude-only files — not needed in the runtime image.
docs/
README.md
CLAUDE.md
.claude/

# Tests. Runtime image does not need them; CI runs `./gradlew test` separately.
test/

# Misc.
*.log
*.swp
