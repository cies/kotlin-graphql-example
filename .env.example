# Required Shopify app settings
SHOPIFY_APP_CLIENT_ID=your_shopify_app_client_id
SHOPIFY_APP_CLIENT_SECRET=your_shopify_app_client_secret
SHOPIFY_SCOPES=read_products,read_orders,write_webhooks,write_merchant_managed_fulfillment_orders,read_merchant_managed_fulfillment_orders
DSS_BASE_URL=https://your-dokploy-domain.example.com

# Backward-compatible legacy names (optional)
# SHOPIFY_API_KEY=your_shopify_api_key
# SHOPIFY_API_SECRET=your_shopify_api_secret

# Optional core settings
OAUTH_REDIRECT_PATH=/oauth/callback
SHOPIFY_API_VERSION=2026-04
PORT=8080
# In Docker, the image defaults to 9999. If your PaaS injects an empty PORT=, the app uses 9999 so the reverse proxy still matches EXPOSE 9999.

# DSS stateless token map (shop|token pairs, comma-separated)
# Example:
# DSS_SHOP_ACCESS_TOKENS=my-store.myshopify.com|shpat_xxx,other-store.myshopify.com|shpat_yyy
DSS_SHOP_ACCESS_TOKENS=

# IMPORTANT: Docker Compose env_file=.env merges like most dotenv parsers — if the same KEY appears twice,
# the LAST line wins. Do not paste a second "Optional monolith" block with MONOLITH_BASE_URL= (empty):
# it will wipe an earlier staging/production URL and the app will log `[monolith] MONOLITH_BASE_URL is unset`.

# Optional monolith (DropNext backend). Set this to your **REST mount root** (no trailing slash).
# Example staging: MONOLITH_BASE_URL=https://staging.dropnext.com/api/shopify-service/v1
# → DSS calls PUT https://staging.dropnext.com/api/shopify-service/v1/stores/api-key ,
#    POST …/orders , etc. (same pattern as MONOLITH_CREATE_ORDER_PATH=/orders).
# Leave MONOLITH_API_PREFIX empty unless you split host vs prefix.
MONOLITH_BASE_URL=
# Path segment(s) inserted after MONOLITH_BASE_URL: {BASE}/{PREFIX}/stores/… Leave empty usually.
MONOLITH_API_PREFIX=
# Bearer token for DSS -> monolith HTTP (Authorization header). NOT the per-shop Shopify Admin token.
# Shopify tokens go in the JSON api_key body on PUT …/stores/api-key after OAuth; quote if value has % etc.
MONOLITH_API_KEY=
MONOLITH_CREATE_ORDER_PATH=/orders
# Allow http:// MONOLITH_BASE_URL (local/dev only).
DSS_ALLOW_INSECURE_MONOLITH=false
# Mirror orders/updated webhooks to the monolith too (default false — orders/create alone avoids duplicate POSTs).
DSS_SYNC_ORDER_ON_UPDATED=false

# Optional internal DSS protection
DSS_API_KEY=change_this_to_a_long_random_secret

# Demo / harness flags (keep false in production)
ENABLE_DEMO_ROUTES=false
ENABLE_TEST_HARNESS=false
SANDBOX_SHOP=harness-sandbox
SANDBOX_ACCESS_TOKEN=