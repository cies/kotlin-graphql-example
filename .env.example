# Required Shopify app settings
SHOPIFY_APP_CLIENT_ID=your_shopify_app_client_id
SHOPIFY_APP_CLIENT_SECRET=your_shopify_app_client_secret
SHOPIFY_SCOPES=read_products,read_orders,write_webhooks,write_merchant_managed_fulfillment_orders,read_merchant_managed_fulfillment_orders
PUBLIC_BASE_URL=https://your-dokploy-domain.example.com

# Backward-compatible legacy names (optional)
# SHOPIFY_API_KEY=your_shopify_api_key
# SHOPIFY_API_SECRET=your_shopify_api_secret

# Optional core settings
OAUTH_REDIRECT_PATH=/oauth/callback
SHOPIFY_API_VERSION=2026-04
PORT=8080

# DSS stateless token map (shop|token pairs, comma-separated)
# Example:
# DSS_SHOP_ACCESS_TOKENS=my-store.myshopify.com|shpat_xxx,other-store.myshopify.com|shpat_yyy
DSS_SHOP_ACCESS_TOKENS=

# Optional monolith integration
MONOLITH_BASE_URL=
MONOLITH_API_KEY=
MONOLITH_CREATE_ORDER_PATH=/orders
DSS_ALLOW_INSECURE_MONOLITH=false

# Optional internal DSS protection
DSS_INTERNAL_SECRET=change_this_to_a_long_random_secret

# Demo / harness flags (keep false in production)
ENABLE_DEMO_ROUTES=false
ENABLE_TEST_HARNESS=false
SANDBOX_SHOP=harness-sandbox
SANDBOX_ACCESS_TOKEN=
DSS_SANDBOX_FAKE_SHOPIFY=false