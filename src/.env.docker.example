# Example env for Docker Compose. Not required on PaaS if you set the same keys in the UI.
#
# Local: docker compose --env-file .env.docker up -d --build
#    or copy these into project-root `.env` and run docker compose up -d --build
#
# In-stack URLs (must match your compose service names):

NODE_ENV="production"

AUTH_SECRET="change-this-to-a-long-random-secret"
# One URL only (e.g. https://platform.example.com). Never comma-separate; breaks Auth.js.
AUTH_URL="http://localhost:3005"
NEXT_PUBLIC_APP_URL="http://localhost:3005"

DATABASE_URL="postgresql://crm:crm_secret@postgres:5432/crm_db"
REDIS_URL="redis://redis:6379"

PLATFORM_ADMIN_EMAILS="alex@websitepuzzle.com"

# ENABLE_PUBLIC_REGISTRATION="true"
