# Database - local Supabase Postgres (direct connection; start stack in Supabase CLI / Docker)
# Pooler URL is not used here; Prisma needs the direct port (often 54324 locally).
#
# Production: prefer a pooler (PgBouncer / host pooler) in transaction mode to avoid exhausting
# Postgres connections with many app instances. See Prisma "External connection poolers" and
# append provider-specific params (e.g. ?pgbouncer=true&connection_limit=1 where supported).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54324/postgres"

# Redis - BullMQ workers + optional app rate limiting (template preview / test send).
REDIS_URL="redis://localhost:6381"

# Auth.js
AUTH_SECRET="change-this-to-a-random-32-char-secret-in-production"
AUTH_URL="http://localhost:3000"

# App - public origin for links, Stripe redirects, emails (set in production, e.g. https://platform.example.com)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional runtime fallback if build did not bake NEXT_PUBLIC_* (Docker): same value as above
# APP_URL="http://localhost:3000"

# Platform operators - comma-separated staff emails that may open /admin (also shows "Platform admin"
# in the staff sidebar when set) and grant Complimentary Premium (no Stripe). Leave empty to hide /admin.
PLATFORM_ADMIN_EMAILS="alex@websitepuzzle.com"

# Public self-service signup (/auth/signup + “Create workspace” on login). Must be exactly "true" to enable.
# When unset or false, only invited/onboarded users can sign in.
# ENABLE_PUBLIC_REGISTRATION="true"

# -----------------------------------------------------------------------------
# Dev test accounts (created by `npm run db:seed`; org slug path: /acme/...)
#
# Staff (ADMIN):         admin@example.com / password123!
# Staff (OWNER):         owner@example.com / password123!
# Staff (PM):            pm@example.com / password123!
# Platform admin (ADMIN): alex@websitepuzzle.com / password123! - pair with PLATFORM_ADMIN_EMAILS above
# -----------------------------------------------------------------------------
